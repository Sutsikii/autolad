{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AutoLad",
  "version": "0.1.0",
  "identifier": "com.autolad.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "AutoLad", "width": 1280, "height": 800, "minWidth": 960, "minHeight": 600 }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPLOCALDATA/proxies/**", "$APPLOCALDATA/thumbs/**", "$APPLOCALDATA/waves/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"],
    "resources": { "../third-party/ffmpeg/LICENSE.txt": "licenses/ffmpeg-LICENSE.txt" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}

